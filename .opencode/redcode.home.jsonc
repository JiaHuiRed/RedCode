{
  "$schema": "https://redcode.dev/config.json",
  // 260612 Red DCP handles dedup/compress/nudge
  "plugin": ["@tarquinen/opencode-dcp"],
  // 260607 Red global inject (engine scans ~/.redcode unconditionally)
  // 260610 Red MEMORY no longer bulk-injected; use /recall + AGENTS CORE block
  // 260613 Red guardrail-profiles/defensive-agent removed — on-demand via skill trigger, save ~4KB/turn
  "instructions": [
    "~/.redcode/USER.md",
    "~/.redcode/skill/memory-automation/SKILL.md",
    "~/.redcode/skill/goal-automation/SKILL.md",
    "~/.redcode/skill/simplify/SKILL.md",
    "~/.redcode/skill/vision-autoagent/SKILL.md",
    "~/.redcode/skill/diagnose/SKILL.md",
    "~/.redcode/skill/hot-trends/SKILL.md"
  ],
  // 260610 Red global plugin (moved to ~/.redcode/redcode.jsonc)
  "mcp": {
    // 260609 CC typegraph: only 3 tsserver type tools kept (type_info/definition/module_exports)
    // rest removed — jcodemunch covers them. Uses node directly (not npx) to avoid process leak.
    "typegraph": {
      "type": "local",
      "command": ["node", "./plugins/typegraph-mcp/node_modules/tsx/dist/cli.mjs", "./plugins/typegraph-mcp/server.ts"],
      "cwd": "$REDCODE_ROOT",
      "environment": {
        "TYPEGRAPH_PROJECT_ROOT": ".",
        "TYPEGRAPH_TSCONFIG": "./tsconfig.json"
      },
      "timeout": 60000,
      "enabled": true
    },
    "jcodemunch": {
      "type": "local",
      "command": ["jcodemunch-mcp"],
      "environment": {
        "JCODEMUNCH_USE_AI_SUMMARIES": "false",
        "PYTHONIOENCODING": "utf-8"
      },
      "enabled": true
    },
    // 260615 Microsoft MarkItDown — 文件转 Markdown 供 LLM 使用
    "markitdown": {
      "type": "local",
      "command": ["markitdown-mcp"],
      "enabled": true
    },
    // 260615 Semgrep — 代码安全扫描 (本地模式, 无需 token)
    "semgrep": {
      "type": "local",
      "command": ["semgrep-mcp"],
      "enabled": true
    },
    "browsermcp": {
      "type": "local",
      "command": ["node", "./browsermcp-server/index.js"],
      "cwd": "$REDCODE_ROOT",
      "enabled": true
    },
    "web-search": {
      "type": "local",
      "command": ["node", "./.opencode/search-server/index.js"],
      "cwd": "$REDCODE_ROOT",
      "timeout": 120000,
      "enabled": true
    },
    "vision": {
      "type": "local",
      "command": ["vision-mcp-server"],
      "environment": {
        "VISION_BASE_URL": "http://localhost:11434/v1/chat/completions",
        "VISION_MODEL": "qwen3-vl:8b"
      },
      "enabled": true
    },
    "su-prememory": {
      "type": "local",
      "command": ["bun", "./plugins/mcp-su-prememory-local/src/index.ts"],
      "cwd": "$REDCODE_ROOT",
      "description": "Local semantic memory — SQLite+FTS5, no cloud",
      "enabled": true
    },
"fff": {
      "type": "local",
      "command": ["fff-mcp"],
      "description": "High-performance file finder & grep (fff_find_files, fff_grep, fff_multi_grep)",
      "enabled": true
    },
  },
  // 260615 Red enable built-in LSP servers (auto-detect by file extension)
  "lsp": true,
  // 260612 Red compaction threshold — engine-level hard ceiling, works alongside DCP as safety net.
  // DCP handles active compress/dedup/nudge; this catches edge cases where DCP doesn't trigger.
  "compaction": {
    "threshold": 150000
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false
  }
}
