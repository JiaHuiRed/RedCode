{
  "$schema": "https://redcode.dev/config.json",
  "plugin": ["@tarquinen/opencode-dcp"],
  "instructions": [
    "~/.redcode/USER.md",
    "~/.redcode/skill/memory-automation/SKILL.md",
    "~/.redcode/skill/goal-automation/SKILL.md",
    "~/.redcode/skill/simplify/SKILL.md",
    "~/.redcode/skill/vision-autoagent/SKILL.md",
    "~/.redcode/skill/diagnose/SKILL.md"
  ],
  "mcp": {
    "typegraph": {
      "type": "local",
      "command": ["node", "./plugins/typegraph-mcp/node_modules/tsx/dist/cli.mjs", "./plugins/typegraph-mcp/server.ts"],
      "cwd": "$REDCODE_ROOT",
      "environment": { "TYPEGRAPH_PROJECT_ROOT": ".", "TYPEGRAPH_TSCONFIG": "./tsconfig.json" },
      "timeout": 60000,
      "enabled": true
    },
    "jcodemunch": {
      "type": "local",
      "command": ["uvx", "jcodemunch-mcp"],
      "environment": { "JCODEMUNCH_USE_AI_SUMMARIES": "false", "PYTHONIOENCODING": "utf-8" },
      "description": "代码符号检索/仓库理解首选——找定义、调用链、改动影响面比 grep 准（search_symbols/get_repo_map/get_call_hierarchy/get_blast_radius/get_symbol_source 等）。改代码前先用它摸清依赖，grep/read 兜底。",
      "enabled": true
    },
    "markitdown": {
      "type": "local",
      "command": ["markitdown-mcp"],
      "description": "把 Office/PDF 等非纯文本文档转 Markdown 供 LLM 读——read 读不了的二进制文档（.docx/.xlsx/.pptx/.pdf）用它提取文本；纯文本/代码仍用 read。",
      "enabled": true
    },
    "browsermcp": {
      "type": "local",
      "command": ["node", "./browsermcp-server/index.js"],
      "cwd": "$REDCODE_ROOT",
      "description": "浏览器自动化（操作网页/抓动态页面）——需先装并连接浏览器扩展。默认关闭，用时改 enabled:true。",
      "enabled": false
    },
    "web-search": {
      "type": "local",
      "command": ["node", "./.opencode/search-server/index.js"],
      "cwd": "$REDCODE_ROOT",
      "description": "联网搜实时信息——知识截止后的新事物、最新文档/版本、外部事实查证时用；本地代码问题用 jcodemunch/grep，不要搜网。",
      "timeout": 120000,
      "enabled": true
    },
    "vision": {
      "type": "local",
      // 260718 Red vision-mcp-server 全局安装版已自带 Ollama 兜底，command 直接用裸命令即可
      "command": ["vision-mcp-server"],
      "environment": {
        "VISION_MODEL": "minicpm-v4.6:f16"
      },
      "description": "图像理解——当前模型非多模态、需看截图/图片内容时用（走本地 Ollama minicpm-v4.6:f16）；纯文本任务不用。",
      "enabled": true
    },
    "su-prememory": {
      "type": "local",
      "command": ["bun", "./plugins/mcp-su-prememory-local/src/index.ts"],
      "cwd": "$REDCODE_ROOT",
      "description": "Local semantic memory — SQLite+FTS5, no cloud",
      "enabled": true
    },
    "mcp-process-mgmt": {
      "type": "local",
      "command": ["bun", "./plugins/mcp-process-mgmt/src/index.ts"],
      "cwd": "$REDCODE_ROOT",
      "description": "管理交互式/长驻 shell 会话（REPL、dev server、需 stdin 的进程）：start_process 起会话、send_input 写 stdin、read_process_output 读输出、stop_process 终止。一次性命令仍用 bash。",
      "enabled": true
    },
    "fff": {
      "type": "local",
      "command": ["fff-mcp"],
      "description": "High-performance file finder & grep (fff_find_files, fff_grep, fff_multi_grep)",
      "enabled": true
    },
    "sqlite-query": {
      "type": "local",
      "command": ["bun", "./plugins/mcp-sqlite-query/src/index.ts"],
      "cwd": "$REDCODE_ROOT",
      "description": "查 SQLite 库优先用本工具而非 bash sqlite3——结构化返回、免 shell 转义。sqlite_query 执行 SQL、sqlite_schema 看表结构。",
      "timeout": 30000,
      "enabled": true
    }
  },
  "disabled_providers": ["ollama-cloud"],
  "small_model": "ollama/qwen3.5:9b-q8_0",
  "compaction": { "threshold": 150000 },
  "tools": { "github-triage": false, "github-pr-search": false },
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "https://api.chhlink.xyz",
        "apiKey": "sk-4fb1e5192a5d9ab7ef42e8f9a6e1b80d0578fdf0e0d2c08debd662da3091580b"
      },
      "models": {
        "claude-sonnet-4-20250514": {
          "name": "Claude Sonnet 4",
          "temperature": true,
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 65536 }
        }
      }
    },
    "ollama": {
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "ornith:35b-q4_K_M": {
          "name": "Ornith 35B",
          "temperature": true,
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 131072, "output": 131072 }
        },
        "ornith:9b-q8_0": {
          "name": "Ornith 9B",
          "temperature": true,
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 131072, "output": 131072 }
        },
        "minicpm-v4.5:q5_K_M": {
          "name": "MiniCPM V4.5",
          "temperature": false,
          "reasoning": false,
          "tool_call": false,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 131072, "output": 131072 }
        },
        "minicpm-v4.6:f16": {
          "name": "MiniCPM V4.6 (轻量)",
          "temperature": false,
          "reasoning": false,
          "tool_call": false,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 131072, "output": 131072 }
        },
        "qwen3.5:9b-q8_0": {
          "name": "Qwen 3.5",
          "temperature": true,
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 163840, "output": 32768 }
        }
      }
    }
  }
}
