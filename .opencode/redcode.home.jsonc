{
  "$schema": "https://redcode.dev/config.json",
  // 260607 Red 全局注入器 — 由 engine 无条件扫描（paths.ts:34-38），
  // 启动 RedCode 时自动加载（任何项目目录均生效）：
  //   - instructions: 自动加载 MEMORY/USER
  //   - mcp: 全局 MCP 服务器（不依赖项目 .opencode/opencode.jsonc）
  //     $REDCODE_ROOT 在运行时自动展开为 RedCode 安装根目录
  // 260607 Red 技能指令 — 自动加载技能（sync-home.bat 同步到 ~/.redcode/skill/）
  "instructions": [
    "~/.redcode/MEMORY.md",
    "~/.redcode/USER.md",
    "~/.redcode/skill/memory-automation/SKILL.md",
    "~/.redcode/skill/guardrail-profiles/SKILL.md",
    "~/.redcode/skill/defensive-agent/SKILL.md",
    "~/.redcode/skill/goal-automation/SKILL.md",
    "~/.redcode/skill/simplify/SKILL.md",
    "~/.redcode/skill/vision-autoagent/SKILL.md",
    "~/.redcode/skill/diagnose/SKILL.md"
  ],
  "mcp": {
    // 260609 CC typegraph 精简版：只留 3 个 tsserver 类型工具（type_info/definition/module_exports），
    // 其余 11 工具 + oxc 图子系统已被 jcodemunch 覆盖故移除。命令改 node 直起 plugin 本地 tsx，
    // 不再走 npx（npx 在 Windows 被 cmd /c 包装，真正的 node 进程脱离 transport.pid 无法被 taskkill /T 回收 → 进程泄漏）。
    "typegraph": {
      "type": "local",
      "command": ["node", "./plugins/typegraph-mcp/node_modules/tsx/dist/cli.mjs", "./plugins/typegraph-mcp/server.ts"],
      "cwd": "$REDCODE_ROOT",
      "environment": {
        "TYPEGRAPH_PROJECT_ROOT": ".",
        "TYPEGRAPH_TSCONFIG": "./tsconfig.json"
      },
      "timeout": 60000,
      "enabled": true
    },
    "jcodemunch": {
      "type": "local",
      "command": ["jcodemunch-mcp"],
      "environment": {
        "JCODEMUNCH_USE_AI_SUMMARIES": "false"
      },
      "enabled": true
    },
    "browsermcp": {
      "type": "local",
      "command": ["node", "./browsermcp-server/index.js"],
      "cwd": "$REDCODE_ROOT",
      "enabled": true
    },
    "web-search": {
      "type": "local",
      "command": ["node", "./.opencode/search-server/index.js"],
      "cwd": "$REDCODE_ROOT",
      "timeout": 120000,
      "enabled": true
    },
    "vision": {
      "type": "local",
      "command": ["vision-mcp-server"],
      "environment": {
        "VISION_BASE_URL": "http://localhost:11434/v1/chat/completions",
        "VISION_MODEL": "qwen3-vl:8b"
      },
      "enabled": true
    },
    "gbrain": {
      "type": "local",
      "command": ["gbrain", "serve"],
      "description": "Persistent memory brain (PGLite, local)",
      "enabled": true,
      "timeout": 120000
    },
    "su-prememory": {
      "type": "local",
      "command": ["bun", "./plugins/mcp-su-prememory-local/src/index.ts"],
      "cwd": "$REDCODE_ROOT",
      "description": "Local semantic memory — SQLite+FTS5, no cloud",
      "enabled": true
    },
    "agent-reach": {
      "type": "local",
      "command": ["bun", "./plugins/agent-reach-mcp/src/index.ts"],
      "cwd": "$REDCODE_ROOT",
      "description": "Unified search — GitHub, Bilibili, Douyin",
      "enabled": true
    },
    "exa-search": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "description": "AI semantic web search (get free key at https://dashboard.exa.ai/api-keys)",
      "enabled": true
    },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false
  }
}
