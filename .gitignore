# 260731 Red `test:ci` 的 junit 落点。此前只有 packages/opencode 自己 ignore 了它，
# app/ui 是因为本地没跑过 test:ci 才碰巧没暴露 —— 提到根上覆盖所有包
packages/*/.artifacts/

# codegraph daemon state (runtime, not source)
.codegraph/

# Python virtual environments in plugins
plugins/*/.venv/

# Vendored external tools — independent clones / binaries, used via global CLI (PATH), not by repo path
# 260610 Red: jcodemunch-mcp 是带 .git 的独立克隆（配置用全局 CLI `jcodemunch-mcp` 不引用此目录）；sqlite-tools 为 sqlite3.exe 二进制
jcodemunch-mcp/
sqlite-tools/

# 260731 Red fff 搜索插件源码 + markitdown 临时 clone（均不参与本仓构建，untracked 噪音）
plugins/fff/
markitdown-temp/

# Personal files — not shared via public repo
# These live in ~/.redcode/ and come from the user's private repo
# (root-level patterns as safety net)
/MEMORY.md
/memory/
seed/memory/*.md
seed/MEMORY.md
seed/skill/memory-automation/*.json

# Project-level .redcode/ is runtime-only (engine auto-creates it)
# All personal config lives in ~/.redcode/ (private repo)
.redcode/

# 260708 Red build-generated + throwaway CLI-output dumps (were untracked, avoid accidental commit)
redcode-web-ui.gen.ts
packages/opencode/doctor_*.log
packages/opencode/doctor_*.txt
packages/opencode/help_output.txt
packages/opencode/models_output.txt
packages/opencode/models_test.txt

# 260801 Red session attachment screenshots (runtime data, not source)
.attachments/

# 260810 cc OpenTUI FFI 调试日志（运行时产物，落在仓库根）
ffi_otui_*.log

# 260824 Red deepsec 安全扫描工作目录（findings 数据库 + 运行时状态，非源码）
.deepsec/

# 260831 cc Claude Code 的会话级工作目录（launch.json 之类的本机开发配置，非源码）
.claude/

# 260831 cc storybook 调试日志（2026-05-25 初始导入时误入仓的产物，跑一次 storybook 就重写一次）
