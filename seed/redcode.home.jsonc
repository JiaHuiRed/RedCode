{
  "$schema": "https://redcode.dev/config.json",
  // 260812 cc 本模板 = 新机器的播种源，落到 ~/.redcode/redcode.jsonc（同步层）。
  // 同步层放"两台机器确实共用的基础"；机器自己新加的 MCP / 供应商写
  // ~/.redcode/redcode.local.jsonc（本地层，私仓 gitignore，不推 GitHub），
  // 确认另一台也要用了才提升进同步层。所以**本模板只收共用项**，
  // 任何含绝对路径、按显存挑的档位、只有某台机装了的东西，一律不进这里。
  // merge-home-config 会把本地层已有的键当"用户已有"跳过，不再补回同步层
  // （260812 修，此前下沉的键每次 build 都被打回，见 script/merge-home-config.ts）。
  //
  // 261010 Red 压缩改由原生 compaction 接管，不再加载 DCP；已有本地层也须移除 DCP 插件项。
  // 其余机器相关的 plugin 路径仍放 redcode.local.jsonc，不在模板里硬编码。
  // instructions 留空键不删：skill 曾双重注册常驻（260718/260902 退役），现全走 skill 发现路径。
  // 本模板与 live 必须同改——同步会反向覆盖。
  "instructions": [],
  // 260804 Red 不设这个键会 fallback 到内置 build（见 config.ts 的 default_agent 注释）。
  "default_agent": "redmind",
  "mcp": {
    // ⚠ #103：块结构必须完整（type/command 必填），tools 是内嵌白名单。
    "jcodemunch": {
      "type": "local",
      "command": ["uvx", "jcodemunch-mcp"],
      "environment": { "JCODEMUNCH_USE_AI_SUMMARIES": "false", "PYTHONIOENCODING": "utf-8" },
      "timeout": 300000,
      "description": "代码符号检索/仓库理解首选——找定义、调用链、改动影响面比 grep 准（search_symbols/search_text/get_symbol_source/get_file_outline/find_references/find_importers 等）。改代码前先用它摸清依赖，grep/read 兜底。",
      "enabled": true,
      "tools": [
        "index_repo",
        "index_folder",
        "get_index_job",
        "list_repos",
        "resolve_repo",
        "get_file_tree",
        "get_file_outline",
        "get_symbol_source",
        "get_file_content",
        "search_symbols",
        "search_text",
        "get_repo_outline",
        "find_importers",
        "find_references",
        "get_context_bundle",
        "get_ranked_context",
        "assemble_task_context",
      ],
    },
    "markitdown": {
      "type": "local",
      "command": ["markitdown-mcp"],
      "description": "把 Office/PDF 等非纯文本文档转 Markdown 供 LLM 读——read 读不了的二进制文档（.docx/.xlsx/.pptx/.pdf）用它提取文本；纯文本/代码仍用 read。",
      "enabled": true,
    },
    "webqa": {
      "type": "local",
      "command": ["node", "./webqa-server/index.js"],
      "cwd": "$REDCODE_ROOT",
      "description": "WebQA v1.4.0 浏览器自动化与视觉验证（Playwright headless）——webqa_interact 跨调用保留页面状态；先 observe 拿 aria 语义快照（带 [ref=sXeY]），再用 aria-ref 定位。支持 click/fill/type/press、clickAt 坐标点击（canvas/终端等自绘控件）、drag 坐标拖拽（真实鼠标管道 move→down→move(steps)→up，指针捕获语义全真，量法同 clickAt）、scroll、hover、waitFor（selector/loadState/url）、tab 多标签（list/new/switch/close）、selector 限定的 observe 与元素截图；单步失败保留已执行结果和 error。截图落 Temp/webqa，多模态主模型直接 read 读图。替代旧 browsermcp（已移除）。",
      "timeout": 120000,
      "enabled": true,
    },
    "web-search": {
      "type": "local",
      "command": ["node", "./seed/search-server/index.js"],
      "cwd": "$REDCODE_ROOT",
      "description": "联网搜实时信息——知识截止后的新事物、最新文档/版本、外部事实查证时用；本地代码问题用 jcodemunch/grep，不要搜网。",
      "timeout": 120000,
      "enabled": true,
    },
    // 260807 起 vision MCP 退役（本地 minicpm 精度/显存不划算）：多模态主模型图片直读，
    // 非多模态模型才派子代理。别再把这个块加回来。
    "su-prememory": {
      "type": "local",
      "command": ["bun", "./plugins/mcp-su-prememory-local/src/index.ts"],
      "cwd": "$REDCODE_ROOT",
      "description": "本机记忆库（SQLite+FTS5，就是 ~/.redcode/supermemory.db，与 MEMORY.md 同一份）——recall 按语义查全文（≥3 字走 FTS5 bm25，更短回落 LIKE，可按 project 限定），stats 看条目分布。写入别用 memory 工具：记忆是「MEMORY.md 索引行 + 库里全文」双写，只写这边会留下有全文无索引的孤儿行。",
      // 260807 Karina: 30 天零调用，白名单留空 = 连接但不注入任何工具
      "tools": [],
      "enabled": true,
    },
    "mcp-process-mgmt": {
      "type": "local",
      "command": ["bun", "./plugins/mcp-process-mgmt/src/index.ts"],
      "cwd": "$REDCODE_ROOT",
      "description": "管理交互式/长驻 shell 会话（REPL、dev server、需 stdin 的进程）：start_process 起 pipe 会话，pty_spawn 起真 PTY 会话（交互式程序首选）；send_input/pty_write 写输入（pty_write 支持 \\x03 等转义序列），read_process_output/pty_read 读输出（pty_read 增量读 + ANSI 剥除 + regex 过滤），stop_process/pty_kill 终止，pty_wait 等退出。一次性命令仍用 bash。",
      "enabled": true,
    },
    "fff": {
      "type": "local",
      "command": ["fff-mcp"],
      "description": "文件名/内容高速检索——fff_find_files 按名字模糊找文件（支持路径前缀与 glob 约束），fff_grep 单模式、fff_multi_grep 多模式 OR 查内容（约束语法可按 *.ts / src/ 预筛）。大范围找东西优先它，比原生 glob/grep 快；已知精确路径直接 read。",
      "enabled": true,
    },
    // 已移除/下沉：chrome-devtools（绝对路径，见本地层，日常用 WebQA 需要时手动开）、
    // github（261024 退役：读侧走原生 github 工具 packages/opencode/src/tool/github.ts，写侧用 gh 命令行）。
  },
  // 保留空数组不删键：merge-home-config 是 deepMergeUserWins，删掉会被当"缺键"补回来。
  // opencode（260917 到期）：免费层按客户端指纹 403，接入=冒充官方客户端，不做；
  // 显式禁用防 models.dev 自动发现复活。
  "disabled_providers": ["opencode"],
  // small_model 与 provider.ollama 在本地层（按各机显存挑）；放这里会被 merge-home-config 当"缺键"补回。
  // 261010 Red 原生压缩替代 DCP compress；颜色预警不执行旧 prune。
  "compaction": {
    "auto": true,
    "prune": false,
    "native": {
      "enabled": true,
      // 261012 Red 兜底线 250k→400k：GPT-6.1 Sol 的 500k 默认甜点位留 100k 余量，
      // 日常仍由输入框按钮主动压缩；此值只作忘记操作时的机械兜底。
      "trigger_tokens": 400000,
      // 261023 Red 压后目标 120k→110k：长会话审计后试降一档（实测基数：重建中位 149k、R/C 0.43、回本 14.7 请求），观察期。
      "target_tokens": 110000,
      "reminder_tokens": 220000,
      // 261023 Red 颜色线随手动甜点位 340k 校准（旧 320k 黄 / 360k 橙）：340k 黄、370k 橙、400k 红。
      "soft_ratio": 0.85,
      "prune_ratio": 0.925,
    },
  },
  "provider": {
    // OpenRouter key 仅存 auth.json；白名单 = 免费层 prompt/completion 均 0 的条目。
    "openrouter": {
      "whitelist": [
        "cohere/north-mini-code:free",
        "dots-studio/dots-3-note-preview:free",
        "google/gemma-4-26b-a4b-it:free",
        "google/gemma-4-31b-it:free",
        "google/lyria-3-clip-preview",
        "google/lyria-3-pro-preview",
        "inclusionai/ling-3.0-flash-fin:free",
        "inclusionai/ling-3.0-flash-sante:free",
        "inclusionai/ling-3.0-flash-vl:free",
        "liquid/lfm-2.5-2.6b:free",
        "nex-agi/nex-n2.5-mini:free",
        "nex-agi/nex-n2.5-pro:free",
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
        "nvidia/nemotron-3-super-120b-a12b:free",
        "nvidia/nemotron-3-ultra-550b-a55b:free",
        "nvidia/nemotron-3.5-content-safety:free",
        "nvidia/nemotron-3.5-lightning:free",
        "openrouter/free",
        "poolside/laguna-s-2.1:free",
        "poolside/laguna-xs-2.1:free",
        "stealth/union-alpha",
        "thinkingmachines/inkling-small:free",
        "thinkingmachines/inkling:free",
        "z-ai/glm-5.2:free"
      ]
    },
    // models.dev 未收录，config 扩展内置（凭据在 auth.json step_plan）；1M/64k、提示缓存、
    // reasoning_effort 三档；定价 7/0.35/20 元每 1M，CNY 表在 provider.ts。
    "stepfun-step-plan": {
      "models": {
        "step-5-preview": {
          "name": "Step 5 Preview",
          "temperature": true,
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 65536 }
        }
      }
    },
    // 260802 Red 接入 SenseNova：tokenplan 套餐定价全 0。apiKey 走 {env:} 占位符，
    // 值由用户级环境变量 SENSENOVA_API_KEY 提供（setx 设置，配置同步模板时不会泄漏明文 key）。
    // 本模板会反向覆盖 live 配置，两处必须保持一致。
    "sensenova": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SenseNova",
      "options": {
        "baseURL": "https://token.sensenova.cn/v1",
        "apiKey": "{env:SENSENOVA_API_KEY}",
      },
      "models": {
        "sensenova-6.7-flash-lite": {
          "name": "SenseNova 6.7 Flash Lite (多模态)",
          "temperature": true,
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 262144, "output": 65536 },
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (SenseNova)",
          "temperature": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 65536 },
        },
        "glm-5.2": {
          "name": "GLM 5.2 (SenseNova)",
          "temperature": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 131072 },
        },
        "sensenova-u1-fast": {
          "name": "SenseNova U1 Fast (文生图)",
          "temperature": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["image"] },
          "limit": { "context": 262144, "output": 65536 },
        },
      },
    },
    // models.dev 目录与线上对不上，这里纠两处：vision-exp 目录整条缺失（补录；1M/384K 是
    // 沿用同族的假设值，官方未公布）；deepseek-chat/reasoner 官方已下线（260828 删死条目）。
    // 注意 reasoning 消耗波动大（同 prompt 实测 65/490 token），输出预算给小会截断正文。
    "deepseek": {
      "models": {
        "deepseek-v4-flash-vision-exp": {
          "name": "DeepSeek V4 Flash Vision (实验)",
          "temperature": true,
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 384000 },
        },
        // 官方正式名：旧名 v4-flash / vision-exp 已下线，请求统一由 V4.1 Flash 服务并按 Flash 计价。
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash (多模态)",
          "temperature": true,
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 384000 },
        },
      },
    },
    // provider.ollama 在本地层（按各机显存挑）；放这里会被 merge-home-config 当"缺键"补回。
    // anthropic 块 260729 起已删（占位 key + 模型 404）——模板与 live 必须同删，否则同步写回。
  },
  // 261027 Red 子代理统一使用 Terra：explore medium、execute high。
  "agent": {
    // 261012 Red 压缩模型与档位继承触发该轮主会话，不要固定 compaction.model/variant。
    "explore": {
      "model": "openai/gpt-6.1-terra",
      "permission": {
        "jcodemunch_*": "allow",
        "indexgraph_*": "allow",
        "web-search_*": "allow",
        "vision_*": "allow"
      },
      "variant": "medium"
    },
    "execute": { "model": "openai/gpt-6.1-terra", "variant": "high" },
  },
  "experimental": { "repeated_tool_failure_limit": 2 },
}
