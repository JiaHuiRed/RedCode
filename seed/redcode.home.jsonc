{
  "$schema": "https://redcode.dev/config.json",
  // 260812 cc 本模板 = 新机器的播种源，落到 ~/.redcode/redcode.jsonc（同步层）。
  // 同步层放"两台机器确实共用的基础"；机器自己新加的 MCP / 供应商写
  // ~/.redcode/redcode.local.jsonc（本地层，私仓 gitignore，不推 GitHub），
  // 确认另一台也要用了才提升进同步层。所以**本模板只收共用项**，
  // 任何含绝对路径、按显存挑的档位、只有某台机装了的东西，一律不进这里。
  // merge-home-config 会把本地层已有的键当"用户已有"跳过，不再补回同步层
  // （260812 修，此前下沉的键每次 build 都被打回，见 script/merge-home-config.ts）。
  //
  // 260809 Red plugin 路径拆到 redcode.local.jsonc（机器相关，不进同步模板）。
  // 两边各自在本地层维护：E 盘机写 E:/AI/RedCode-dcp，D 盘机写 D:/AI/KLX/Qiu/RedCode-dcp。
  // 本模板不留硬编码路径，避免 pull 后覆盖对方的 live 配置。
  // 260718 Red goal-automation/simplify/vision-autoagent/diagnose 之前既是可懒加载的
  // skill、又整篇塞在这里常驻系统提示词，双重注册白吃了 ~2800 token/次对话。这几个
  // 不需要"每次都自动触发"（不像 memory-automation），改成只留 skill 发现路径——
  // 系统提示词里只放名字+描述，模型需要时自己调 skill 工具加载全文。
  // 260730 Karina USER.md 下线：用户画像基本被 souls/*.md 覆盖，留着只是每轮多一道加载。
  // TUI 标签上的称呼改由 config 的 username 字段提供（缺省退到系统用户名）。
  // 这份 shipped 模板必须跟 live 配置一起改 —— 只改 live 的话同步时会被模板反向覆盖回来。
  "instructions": ["~/.redcode/skill/memory-automation/SKILL.md"],
  // 260804 Red 不设这个键会 fallback 到内置 build（见 config.ts 的 default_agent 注释）。
  "default_agent": "redmind",
  // 260804 Red 切换列表里那个多余的 "agent" 来自随包发行的内置 profile
  // （src/agent/profile/default/agent.yaml，description 与 build 完全相同），
  // 从配置里删条目没用、每次启动都会重新造出来，只能 disable。
  // 这里只放 disable 一项：live 配置的 agent 段还有 explore 等内容，别在模板里重写整段。
  "agent": { "agent": { "disable": true } },
  "mcp": {
    "typegraph": {
      "type": "local",
      "command": ["node", "./plugins/typegraph-mcp/node_modules/tsx/dist/cli.mjs", "./plugins/typegraph-mcp/server.ts"],
      "cwd": "$REDCODE_ROOT",
      "environment": { "TYPEGRAPH_PROJECT_ROOT": ".", "TYPEGRAPH_TSCONFIG": "./tsconfig.json" },
      "timeout": 60000,
      "tools": ["ts_type_info"],
      "enabled": true
    },
    "jcodemunch": {
      "type": "local",
      "command": ["uvx", "jcodemunch-mcp"],
      "environment": { "JCODEMUNCH_USE_AI_SUMMARIES": "false", "PYTHONIOENCODING": "utf-8" },
      "description": "代码符号检索/仓库理解首选——找定义、调用链、改动影响面比 grep 准（search_symbols/get_repo_map/get_call_hierarchy/get_blast_radius/get_symbol_source 等）。改代码前先用它摸清依赖，grep/read 兜底。",
      "enabled": true
    },
    "markitdown": {
      "type": "local",
      "command": ["markitdown-mcp"],
      "description": "把 Office/PDF 等非纯文本文档转 Markdown 供 LLM 读——read 读不了的二进制文档（.docx/.xlsx/.pptx/.pdf）用它提取文本；纯文本/代码仍用 read。",
      "enabled": true
    },
    "webqa": {
      "type": "local",
      "command": ["node", "./webqa-server/index.js"],
      "cwd": "$REDCODE_ROOT",
      "description": "浏览器视觉验证（Playwright headless）——webqa_screenshot 截图、webqa_interact 驱动点击/输入/eval，截图落 Temp\\webqa，审图派多模态子代理（mimo-v2.5）read 图片。替代旧 browsermcp（需浏览器扩展+手动 Connect，已移除）。",
      "timeout": 120000,
      "enabled": true
    },
    "web-search": {
      "type": "local",
      "command": ["node", "./seed/search-server/index.js"],
      "cwd": "$REDCODE_ROOT",
      "description": "联网搜实时信息——知识截止后的新事物、最新文档/版本、外部事实查证时用；本地代码问题用 jcodemunch/grep，不要搜网。",
      "timeout": 120000,
      "enabled": true
    },
    // 260807 哥哥拍板：vision MCP 整体退役，识图统一走多模态子代理（task 派 explore，
    // mimo-v2.5 原生多模态，用 read 直接读图）。理由不是它坏了，是本地 minicpm 精度有
    // 上限、还要占显存与 Ollama 宿主内存，而派子代理看一次图只要几分钱，成本不构成理由。
    // 配套改动：prompt.ts 的 VISION CAPABILITY 权威注入、skill/vision-autoagent、
    // 三个子代理的 vision_* 放行均已同步。别再把这个块加回来。
    "su-prememory": {
      "type": "local",
      "command": ["bun", "./plugins/mcp-su-prememory-local/src/index.ts"],
      "cwd": "$REDCODE_ROOT",
      "description": "Local semantic memory — SQLite+FTS5, no cloud",
      // 260807 Karina: 30 天零调用，白名单留空 = 连接但不注入任何工具
      "tools": [],
      "enabled": true
    },
    "mcp-process-mgmt": {
      "type": "local",
      "command": ["bun", "./plugins/mcp-process-mgmt/src/index.ts"],
      "cwd": "$REDCODE_ROOT",
      "description": "管理交互式/长驻 shell 会话（REPL、dev server、需 stdin 的进程）：start_process 起 pipe 会话，pty_spawn 起真 PTY 会话（交互式程序首选）；send_input/pty_write 写输入（pty_write 支持 \\x03 等转义序列），read_process_output/pty_read 读输出（pty_read 增量读 + ANSI 剥除 + regex 过滤），stop_process/pty_kill 终止，pty_wait 等退出。一次性命令仍用 bash。",
      "enabled": true
    },
    "fff": {
      "type": "local",
      "command": ["fff-mcp"],
      "description": "High-performance file finder & grep (fff_find_files, fff_grep, fff_multi_grep)",
      "enabled": true
    },
    "sqlite-query": {
      "type": "local",
      "command": ["bun", "./plugins/mcp-sqlite-query/src/index.ts"],
      "cwd": "$REDCODE_ROOT",
      "description": "查 SQLite 库优先用本工具而非 bash sqlite3——结构化返回、免 shell 转义。sqlite_query 执行 SQL、sqlite_schema 看表结构。",
      "timeout": 30000,
      "enabled": true
    },
    // chrome-devtools MCP 挪到本地层 redcode.local.jsonc（260811 cc）：命令是
    // npm 全局安装的绝对路径（C:/Users/<用户名>/AppData/Roaming/npm/...），换机
    // 必 ENOENT，与 DCP 插件路径同一类"因机而异"的值。配置样例见该文件。
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "X-MCP-Toolsets": "default,actions" },
      "description": "GitHub 官方 MCP（github/github-mcp-server 远程托管）——PR/issue/仓库/用户 + CI Actions 工具集。首次连接走 OAuth 浏览器授权，无需 PAT。工具集用 X-MCP-Toolsets 控制（default,actions），避免全量 60+ 工具撑爆前缀。",
      "timeout": 60000,
      "enabled": true
    }
  },
  "disabled_providers": ["ollama-cloud", "opencode"],
  // small_model 挪到本地层 redcode.local.jsonc（260812 cc）：它引用本机 ollama 模型，
  // 而本地模型是按各机显存挑的，随 provider.ollama 一起下沉。留在这里会被 merge-home-config
  // 当"用户缺的键"补回 redcode.jsonc——260811/260812 两次回潮正是如此。
  "compaction": { "threshold": 400000 },
  "tools": { "github-triage": false, "github-pr-search": false },
 "provider": {
   // 260802 Red 接入 SenseNova：tokenplan 套餐定价全 0。apiKey 走 {env:} 占位符，
   // 值由用户级环境变量 SENSENOVA_API_KEY 提供（setx 设置，配置同步模板时不会泄漏明文 key）。
   // 本模板会反向覆盖 live 配置，两处必须保持一致。
   "sensenova": {
     "npm": "@ai-sdk/openai-compatible",
     "name": "SenseNova",
     "options": {
       "baseURL": "https://token.sensenova.cn/v1",
       "apiKey": "{env:SENSENOVA_API_KEY}"
     },
     "models": {
       "sensenova-6.7-flash-lite": {
         "name": "SenseNova 6.7 Flash Lite (多模态)",
         "temperature": true,
         "reasoning": true,
         "tool_call": true,
         "attachment": true,
         "modalities": { "input": ["text", "image"], "output": ["text"] },
         "limit": { "context": 262144, "output": 65536 }
       },
       "deepseek-v4-flash": {
         "name": "DeepSeek V4 Flash (SenseNova)",
         "temperature": true,
         "reasoning": true,
         "tool_call": true,
         "modalities": { "input": ["text"], "output": ["text"] },
         "limit": { "context": 1048576, "output": 65536 }
       },
       "glm-5.2": {
         "name": "GLM 5.2 (SenseNova)",
         "temperature": true,
         "reasoning": true,
         "tool_call": true,
         "modalities": { "input": ["text"], "output": ["text"] },
         "limit": { "context": 1048576, "output": 131072 }
       },
       "sensenova-u1-fast": {
         "name": "SenseNova U1 Fast (文生图)",
         "temperature": true,
         "reasoning": true,
         "tool_call": true,
         "modalities": { "input": ["text"], "output": ["image"] },
         "limit": { "context": 262144, "output": 65536 }
       }
     }
   }
   // 260729 Red 删除 anthropic 块。它有三重无效：apiKey 是占位符、ANTHROPIC_API_KEY 未设、
   // 唯一的模型 gpt-5-chat-latest 经实测根本不存在（请求 404，见 codex 块注释）。
    // 更要紧的是：只删 live 的 ~/.redcode/redcode.jsonc 不够 —— 本模板会在同步时把它写回去，
    // 今天就实际发生了一次（删完当天又出现在 live 文件的 git diff 里）。同类坑 0.7.25
    // 的 vision-mcp 已经栽过一次，两处必须一起删。
    // provider.ollama 挪到本地层 redcode.local.jsonc（260812 cc）：本地模型按各机显存挑
    // （minicpm 档位、qwen 量化级别两机各选各的），与 small_model 一起下沉。配置样例见该文件。
    // 留在这里会被 merge-home-config 当"用户缺的键"补回 redcode.jsonc——260811/260812 两次
    // 回潮正是如此。同类坑：anthropic 块（见上）、0.7.25 的 vision-mcp、260713 的 FreeLLMAPI。
  }
}
