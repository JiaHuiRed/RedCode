    { "id": "steer-parent-notice", "file": "packages/redspace/src/tool/task.ts", "match": "User steering sent to background task", "channel": "history", "cap": "固定模板 ~210 字节 + 用户原文（bounded-by:STEERING_MESSAGE_MAX_BYTES 16,384 UTF-8 bytes / 单条）", "stability": "synthetic noReply 追加一条；累计随会话历史增长，与其它历史消息同受既有压缩处理", "note": "父会话可追溯记录；queued→delivered 只改同一条 part，不新增条目" }
