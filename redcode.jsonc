{
  "$schema": "https://redcode.dev/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["npx", "-y", "@colbymchenry/codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "typegraph": {
      "type": "local",
      "command": ["D:\\AI\\RedCode\\plugins\\typegraph-mcp\\node_modules\\.bin\\tsx", "D:\\AI\\RedCode\\plugins\\typegraph-mcp\\server.ts"],
      "environment": {
        "TYPEGRAPH_PROJECT_ROOT": "D:\\AI\\RedCode",
        "TYPEGRAPH_TSCONFIG": "D:\\AI\\RedCode\\tsconfig.json"
      },
      "enabled": true
    }
  }
}
