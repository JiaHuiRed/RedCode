#!/bin/sh
set -e
# Check if bun version matches package.json
# keep in sync with packages/opencode/script/build.ts bun version qualifier
bun -e '
import { semver } from "bun";
const pkg = await Bun.file("package.json").json();
const expectedBunVersion = pkg.packageManager?.split("@")[1];
if (!expectedBunVersion) {
  throw new Error("packageManager field not found in root package.json");
}
const expectedBunVersionRange = `^${expectedBunVersion}`;
if (!semver.satisfies(process.versions.bun, expectedBunVersionRange)) {
  throw new Error(`This script requires bun@${expectedBunVersionRange}, but you are using bun@${process.versions.bun}`);
}
if (process.versions.bun !== expectedBunVersion) {
  console.warn(`Warning: Bun version ${process.versions.bun} differs from expected ${expectedBunVersion}`);
}
'
# 子进程超时不变量：秒级文本扫描，放在 typecheck 前面，坏了立刻知道
bun run script/check-subprocess-timeout.ts
# 261013 Red 工具描述源码预算：递归计 UTF-8 字节，超 32KiB 失败，不做运行时截断。
bun run check:tool-description-budget
# 裸控制字节不变量：全仓字节扫描。裸 NUL 会让文件对 grep/ripgrep 整个隐身（见 7dec94a7）
bun run script/check-control-bytes.ts
# OpenAPI 生成物不变量（约 6s）：改了 config schema 却忘记重跑生成物，本地全绿、推上去
# 才在 CI 红。260828 一上午撞两次（webfetch.allow_private_hosts、image 的 max_pixels/
# max_dimension），两次都是别的会话合并时才发现。脚本自己无副作用（见其头注释）。
bun run check:openapi-drift
# 261013 Red 全仓 typecheck 移出 pre-push：tsgo 崩溃回退 tsc 时是分钟级，每次 push 都付
# 不划算；CI typecheck.yml 同一条全量兜底（防本地跳过钩子与并行会话合并）。留在 pre-push
# 的是秒级扫描（超时不变量/工具描述预算/控制字节/openapi-drift），拦截成本近零。

