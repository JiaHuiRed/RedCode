{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RedCode Dev",
  "version": "0.7.34",
  "identifier": "ai.redcode.desktop.dev",
  "build": {
    "frontendDist": "../out/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RedCode",
        "width": 1200,
        "height": 800,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/redcode"]
  }
}
