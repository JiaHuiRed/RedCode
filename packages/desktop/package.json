{
  "name": "@redcode-ai/desktop",
  "private": true,
  "version": "0.7.14",
  "type": "module",
  "license": "MIT",
  "homepage": "https://redcode.dev",
  "author": {
    "name": "RedCode",
    "email": "red@redcode.dev"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "bun test --preload ./bun-preload.ts src",
    "test:ci": "mkdir -p .artifacts/unit && bun test --preload ./bun-preload.ts src --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml",
    "gen:tauri-commands": "bun ./scripts/gen-tauri-commands.ts",
    "predev": "bun ./scripts/predev.ts",
    "dev": "electron-vite dev",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --config electron-builder.config.ts",
    "package:mac": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --mac --config electron-builder.config.ts",
    "package:win": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --win --config electron-builder.config.ts",
    "package:linux": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --linux --config electron-builder.config.ts",
    "native:build": "bun install --cwd native"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@electron/asar": "4.2.0",
    "@tauri-apps/api": "^2",
    "@zip.js/zip.js": "2.7.62",
    "electron-context-menu": "4.1.2",
    "electron-log": "^5",
    "electron-store": "^10",
    "electron-updater": "^6",
    "electron-window-state": "^5.0.3",
    "marked": "^15"
  },
  "devDependencies": {
    "@actions/artifact": "4.0.0",
    "@lydell/node-pty": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "@redcode-ai/app": "workspace:*",
    "@redcode-ai/ui": "workspace:*",
    "@sentry/solid": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/storage": "catalog:",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "0.15.4",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@valibot/to-json-schema": "1.6.0",
    "electron": "42.4.1",
    "electron-builder": "^26",
    "electron-vite": "^5",
    "solid-js": "catalog:",
    "sury": "11.0.0-alpha.4",
    "typescript": "catalog:",
    "vite": "catalog:",
    "zod-openapi": "5.4.6"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.10",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1"
  }
}
