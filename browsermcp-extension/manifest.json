{
  "manifest_version": 3,
  "name": "Browser MCP Bridge",
  "version": "1.0.3",
  "description": "Connects browser to MCP server for AI automation",
  "permissions": ["activeTab", "scripting", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser MCP"
  }
}
